# ECOSCOL Backend - Variables d'environnement
# Copier ce fichier en .env et renseigner les valeurs réelles.

# Environnement: development | test | production
NODE_ENV=development

# Port du serveur API
PORT=4000

# URL publique du backend (pour CORS et liens dans les documents)
BACKEND_URL=http://localhost:4000

# URL publique du frontend (CORS autorisé)
FRONTEND_URL=http://localhost:5173

# Base de données PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecoscol
DB_USER=postgres
DB_PASSWORD=postgres

# Secret JWT (à générer et changer en production) - jamais commité
JWT_SECRET=changez-moi-en-production
JWT_EXPIRES_IN=8h

# Limitation des tentatives de connexion
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=10

# Nombre de jours de conservation des sauvegardes locales
BACKUP_RETENTION_DAYS=14