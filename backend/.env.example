# ECOSCOL Backend — variables d'environnement

NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# PostgreSQL (en prod : passer par PgBouncer, port 6432)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecoscol
DB_USER=postgres
DB_PASSWORD=senpai

# Redis (cache + queues BullMQ)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT — OBLIGATOIRE en production (générer : openssl rand -hex 32)
JWT_SECRET=insecure-dev-secret
JWT_EXPIRES_IN=8h

# Anti-bruteforce login
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=10

# Workers BullMQ
QUEUE_CONCURRENCY=5

# Logs : debug | info | warn | error
LOG_LEVEL=debug
